{
  "name": "domo",
  "version": "1.0.0",
  "description": "A voice-first control room for coding agents — talk to a Gemini Live agent that spawns, monitors and directs Claude Code and Codex sessions over ACP.",
  "type": "module",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "build": "nuxt build",
    "dev": "node scripts/dev.mjs",
    "dev:http": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --project unit --project nuxt --project integration",
    "test:offline": "DOMO_TEST_ALLOW_SKIP=1 vitest run --project unit --project nuxt",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:integration": "vitest run --project integration",
    "test:docker": "vitest run --project unit --project docker-live test/docker",
    "test:watch": "vitest --project unit --project nuxt"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.78.0",
    "@agentclientprotocol/codex-acp": "^1.12.0",
    "@agentclientprotocol/sdk": "^1.4.0",
    "@devcontainers/cli": "^0.89.0",
    "@electric-sql/client": "^1.5.28",
    "@google/genai": "^2.22.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nuxt/ui": "^4.11.1",
    "@openai/codex": "^0.154.0",
    "@tanstack/db": "^0.9.2",
    "@tanstack/electric-db-collection": "^0.4.10",
    "@tanstack/vue-db": "^0.2.1",
    "@vueuse/core": "^14.4.0",
    "jsonc-parser": "^3.3.1",
    "marked": "^18.0.13",
    "nuxt": "^4.5.2",
    "pg": "^8.23.0",
    "shiki": "^4.4.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.132",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@vue/test-utils": "^2.5.1",
    "ai": "^7.0.102",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
