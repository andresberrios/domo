{
  "name": "domo",
  "version": "1.0.0",
  "description": "A voice-first control room for coding agents — talk out loud to Claude Code, Codex and OpenCode sessions over ACP, and have them spawn, monitor and direct each other.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nuxt build",
    "dev": "node scripts/dev.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "release:publish": "node scripts/publish-release.mjs",
    "test": "vitest run --project unit --project nuxt --project integration --project electric",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:integration": "vitest run --project integration",
    "test:electric": "vitest run --project electric",
    "test:docker": "vitest run --project unit --project docker-live test/docker",
    "test:agents": "vitest run --project agents-live",
    "test:environments": "vitest run --project environments-live",
    "test:watch": "vitest --project unit --project nuxt"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.90.0",
    "@agentclientprotocol/codex-acp": "^2.2.2",
    "@agentclientprotocol/sdk": "^1.8.0",
    "@devcontainers/cli": "^0.89.0",
    "@electric-sql/client": "^1.5.28",
    "@github/copilot": "1.0.98",
    "@google/genai": "^2.22.0",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@msgpack/msgpack": "^3.1.3",
    "@nuxt/ui": "^4.11.1",
    "@openai/codex": "^0.162.1",
    "@opencode/cli": "2.0.29",
    "@tanstack/db": "^0.9.2",
    "@tanstack/electric-db-collection": "^0.4.10",
    "@tanstack/vue-db": "^0.2.1",
    "@tanstack/vue-virtual": "^3.13.39",
    "@vueuse/core": "^14.4.0",
    "@xai-official/grok": "1.0.62",
    "jsonc-parser": "^3.3.1",
    "kokoro-js": "^1.2.1",
    "marked": "^18.0.13",
    "nuxt": "^4.5.2",
    "onnxruntime-node": "1.21.0",
    "pg": "^8.23.0",
    "sharp": "0.34.5",
    "shiki": "^4.4.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.132",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "@vue/test-utils": "^2.5.1",
    "ai": "^7.0.102",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.5",
    "playwright-core": "1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
