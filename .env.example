# Copy to .env for local overrides. All optional — sane defaults apply.

# Domo data dir (SQLite state.db lives here; session_events transcript +
# pending_diffs + projects/envs/sessions/settings/users all in one file).
# DOMO_HOME=/home/you/.domo

# Coast daemon HTTP API (legacy — environments swap to devcontainers in
# step 3 of the new-architecture build).
# DOMO_COAST_API_URL=http://127.0.0.1:31415

# Directory picker initial path for the project-add wizard.
# DOMO_PROJECTS_ROOT=/home/you
