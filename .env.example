# Copy to .env for local overrides. All optional — sane defaults apply.

# Domo data dir (SQLite state.db, IDE-bridge lock files live in ~/.claude/ide).
# DOMO_HOME=/home/you/.domo

# Coast daemon HTTP API.
# DOMO_COAST_API_URL=http://127.0.0.1:31415

# Directory picker initial path for the project-add wizard.
# DOMO_PROJECTS_ROOT=/home/you

# --- Electric Agents (Phase 3 session runtime) ---
# agents-server control plane (docker-compose maps these to localhost).
# DOMO_AGENTS_SERVER_URL=http://127.0.0.1:4437
# Stable id for this Domo runtime's pull-wake runner.
# DOMO_AGENTS_RUNNER_ID=domo-runtime
# docker-compose host port overrides.
# DOMO_AGENTS_PORT=4437
# DOMO_AGENTS_STREAMS_PORT=4438
# DOMO_PG_PORT=54329
