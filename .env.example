# Google Gemini API key — powers the Live (voice) agent.
# Get one at https://aistudio.google.com/apikey
NUXT_GEMINI_API_KEY=

# Optional, and the recommended way to run Claude Code in a development
# environment. Generate with `claude setup-token` (one year, billed to your
# Claude subscription, stored nowhere by the CLI). Forwarded to the adapter as
# CLAUDE_CODE_OAUTH_TOKEN.
# NUXT_CLAUDE_CODE_OAUTH_TOKEN=

# Optional. Only needed if you are NOT already logged in with the Claude CLI
# (`claude /login`) and have no OAuth token above. Note that an API key WINS
# over any subscription login inside Claude Code, so Domo passes it only when
# there is no other credential — otherwise the work would bill the API.
NUXT_ANTHROPIC_API_KEY=

# Optional. Codex can use an existing `codex login`, CODEX_API_KEY, or an
# OpenAI API key. Domo forwards either of these aliases to the Codex ACP adapter.
NUXT_CODEX_API_KEY=
# NUXT_OPENAI_API_KEY=

# Postgres + Electric (started by `docker compose up -d`).
DATABASE_URL=postgresql://postgres:password@localhost:54321/domo
ELECTRIC_URL=http://localhost:30000

# Optional. Live model id to use for the voice agent. Can also be changed in
# Settings at runtime.
# NUXT_GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional. Default directory new coding agents work in.
# NUXT_DEFAULT_CWD=/home/you/code

# Optional. Pin the model each coding agent runs on, install-wide. The id (or an
# alias, or the display name) has to be one the adapter offers in its ACP
# `configOptions`; a session whose pin matches nothing fails to start and the
# error lists what was on offer.
# NUXT_CLAUDE_MODEL=claude-haiku-4-5
# NUXT_CODEX_MODEL=gpt-5-mini

# Optional. Where uploads are stored. Defaults to ./.data
# NUXT_DATA_DIR=

# Optional. Base image of Domo's built-in development environment definition.
# NUXT_DEV_ENV_IMAGE=mcr.microsoft.com/devcontainers/base:ubuntu-24.04

# Optional. Where the shared runtime volume (Node + both ACP adapters, mounted
# read-only into every environment) takes its Node from. Must be glibc-based.
# NUXT_DEV_ENV_RUNTIME_IMAGE=node:22-bookworm-slim

# Optional. Claude login/config mounted into managed development environments.
# Defaults to ~/.claude when it exists.
# NUXT_CLAUDE_CONFIG_DIR=/home/you/.claude

# Optional. Codex login/config mounted into managed development environments.
# Defaults to ~/.codex when it exists.
# NUXT_CODEX_CONFIG_DIR=/home/you/.codex
