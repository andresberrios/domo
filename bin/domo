#!/bin/sh
# Domo host CLI — manages the one Nitro app process. Shipped inside the
# release tarball; the installer drops a PATH shim that execs this. See
# initial-design.md "Distribution" (Decided #14: no engine infra — the
# in-process engine + SQLite replaced the agents-server compose stack).
set -eu

# Release root = parent of this script's dir (tarball: <root>/{bin,.output}).
SELF=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$SELF/.." && pwd)
ENTRY="$ROOT/.output/server/index.mjs"
# Bundled Node ships in the release (no system Node requirement);
# fall back to a system `node` only if it's somehow absent.
NODE="$ROOT/runtime/bin/node"
[ -x "$NODE" ] || NODE="node"

# Match server/lib/paths.ts: DOMO_HOME > $XDG_DATA_HOME/domo > ~/.domo
if [ -n "${DOMO_HOME:-}" ]; then HOME_DIR="$DOMO_HOME";
elif [ -n "${XDG_DATA_HOME:-}" ]; then HOME_DIR="$XDG_DATA_HOME/domo";
else HOME_DIR="$HOME/.domo"; fi
RUN_DIR="$HOME_DIR/run"
PIDFILE="$RUN_DIR/domo.pid"
LOGFILE="$RUN_DIR/domo.log"
PORT="${PORT:-7575}"
# Bind localhost-only by default — Domo has no per-user network isolation
# beyond the cookie-authed app, and once exposed grants whoever reaches the
# port full host file/git/terminal/claude control. Remote access is meant
# to go through Tailscale / a Cloudflare Tunnel / an auth proxy (all of
# which connect to localhost). Opt into a wider interface explicitly with
# DOMO_BIND=0.0.0.0. See docs/site/securing-your-install.md.
BIND="${DOMO_BIND:-127.0.0.1}"
INSTALL_URL="${DOMO_INSTALL_URL:-https://github.com/andresberrios/domo/releases/latest/download/install.sh}"

mkdir -p "$RUN_DIR"

err() { echo "domo: $*" >&2; }
die() { err "$*"; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

app_running() {
  [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

cmd_app_stop() {
  if app_running; then
    kill "$(cat "$PIDFILE")" 2>/dev/null || true
    echo "domo: app stopped"
  fi
  rm -f "$PIDFILE"
}

cmd_app_start() {
  if app_running; then
    echo "domo: app already running (pid $(cat "$PIDFILE")) at http://localhost:${PORT}"
    return 0
  fi
  echo "domo: starting app on :${PORT}…"
  DOMO_HOME="$HOME_DIR" PORT="$PORT" HOST="$BIND" NITRO_HOST="$BIND" \
    nohup "$NODE" "$ENTRY" >"$LOGFILE" 2>&1 &
  echo $! >"$PIDFILE"
  sleep 1
  app_running || die "app failed to start — see: domo logs"
  echo "domo: up → http://localhost:${PORT}  (logs: domo logs)"
}

cmd_up() {
  [ -x "$NODE" ] || have node || die "no Node runtime (bundled binary missing and no system node)."
  have docker || err "warning: 'docker' not found — needed for the devcontainer-backed env containers."
  have claude || err "warning: 'claude' not found — log in once with the Claude Code CLI."
  cmd_app_start
}

cmd_restart() {
  cmd_app_stop
  cmd_app_start
}

cmd_down() {
  cmd_app_stop
}

cmd_status() {
  if app_running; then echo "app: running (pid $(cat "$PIDFILE")) http://localhost:${PORT}"
  else echo "app: stopped"; fi
  echo "version: $(cmd_version)"
  echo "home:    $HOME_DIR"
}

cmd_logs() {
  [ -f "$LOGFILE" ] || die "no app log yet ($LOGFILE)"
  tail -n 200 -f "$LOGFILE"
}

cmd_version() {
  if [ -f "$ROOT/VERSION" ]; then cat "$ROOT/VERSION"; else echo "unknown"; fi
}

cmd_update() {
  have curl || die "curl is required to update."
  was_running=no
  app_running && was_running=yes
  echo "domo: fetching latest release…"
  curl -fsSL "$INSTALL_URL" | sh
  if [ "$was_running" = yes ]; then
    echo "domo: restarting…"
    "$HOME_DIR/app/current/bin/domo" restart
  else
    echo "domo: updated. Run: domo up"
  fi
}

case "${1:-}" in
  up)      cmd_up ;;
  down)    cmd_down ;;
  restart) cmd_restart ;;
  status)  cmd_status ;;
  logs)    cmd_logs ;;
  update)  cmd_update ;;
  version) cmd_version ;;
  *)
    cat >&2 <<EOF
domo — run parallel Claude Code agents over isolated dev environments

usage: domo <command>
  up         start the app on :${PORT}
  down       stop the app
  restart    stop then start the app
  status     show app state
  logs       tail the app log
  update     fetch + install the latest release, then restart if running
  version    print the installed version
EOF
    [ "${1:-}" = "help" ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "" ] && exit 0
    exit 2 ;;
esac
