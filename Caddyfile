# HTTPS front for `pnpm dev`. Browsers only expose the microphone on secure
# origins, so this is what lets you open Domo from another device.
#
# Caddy issues the certificate from its local CA; run `caddy trust` once so the
# browser accepts it. Override the address with DOMO_HTTPS_ADDRESS, e.g.
# `DOMO_HTTPS_ADDRESS=my-mac.local:3666 pnpm dev`.
{
	admin off
	skip_install_trust
}

# `host.docker.internal` is here so an agent in a dev environment can open Domo
# in its own browser. The port was always reachable from a container — Caddy
# binds the wildcard — but with only `localhost` named there was no certificate
# for that SNI and the handshake was refused outright. Without it the single
# reachable address is the Nuxt dev server on plain HTTP, where Electric's shape
# long-polls exhaust HTTP/1.1's six connections per origin: the first tab
# renders and every later one comes back blank. The container does not trust
# Caddy's local CA and does not need to; the browser is told to ignore that.
{$DOMO_HTTPS_ADDRESS:localhost:3666}, host.docker.internal:{$DOMO_HTTPS_PORT:3666} {
	tls internal
	reverse_proxy 127.0.0.1:{$DOMO_DEV_PORT:3667}
}
